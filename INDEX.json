{
  "name": "qixia-skills",
  "display_name": "齐夏 skills",
  "version": "1.0.0",
  "updated": "2026-11-11",
  "scope": "面向 agent 的谋略与博弈决策包：方法论模式（P1–P5）+ 可计算的博弈论模型（G1–G12）+ 案例与证据基线。用于对抗性博弈、谈判、红队演练与规则审计；不用于对真实个人实施欺诈、胁迫或诱导自伤。",
  "requires": {
    "python": ">=3.8",
    "third_party": [],
    "network": "不需要（全部离线，证据已固化在包内）"
  },
  "entrypoints": {
    "skill": "SKILL.md",
    "quickstart": "QUICKSTART.md",
    "routing": "ROUTING.md",
    "index": "INDEX.json",
    "cli": "qixia.py",
    "methodology_overview": "methodology/00-methodology-overview.md",
    "pattern_index": "methodology/patterns.index.json",
    "casebook": "methodology/casebook.yaml",
    "pattern_cli": "methodology/scripts/pattern_cli.py",
    "pattern_validate": "methodology/scripts/validate.py",
    "gt_engine": "scripts/gt/qixia_gt.py",
