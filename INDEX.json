  "routing": {
    "entry_command": "python3 qixia.py ask \"<情境>\"",
    "note": "P 层由 methodology/scripts/pattern_cli.py match 计算（单一事实来源），G 层由本文件的 model_keywords 打分；两者都返回 score 与命中词，便于 agent 记录判断依据。",
    "model_keywords": [
      {
        "code": "G1",
        "name": "囚徒困境 / 重复博弈",
        "solver": "pd",
        "case": "g1_pd_278.json",
        "why": "双方同时选、有明确收益矩阵、可能重复",
        "keywords": [
          "合作",
          "背叛",
          "囚徒困境",
          "出卖",
          "联手",
          "报复",
          "惩罚",
