    "gt_cases_index": "skills/game-theory/CASES.md",
    "gt_checklists": "skills/game-theory/checklists.md",
    "gt_case_manifest": "cases/gt/manifest.json",
    "evidence": "knowledge/sources/shiri_baike.txt",
    "prompts_index": "prompts/README.md",
    "version_file": "VERSION",
    "package_checker": "scripts/check_package.py",
