    },
    {
      "id": "L2",
      "name": "模型层（G1–G12）",
      "role": "为什么成立、成立的条件、数值上值不值",
      "read_order": 3,
      "paths": [
        "skills/game-theory/SKILL.md",
        "skills/game-theory/AGENT_PLAYBOOK.md",
        "skills/game-theory/SCHEMAS.md",
        "skills/game-theory/CASES.md",
