        ]
      },
      {
        "code": "G2",
        "name": "不完全信息 / 贝叶斯更新",
        "solver": "bayes",
        "case": "g2_bayes_siqingshan.json",
        "why": "真假难辨、要不要花钱/冒险去查",
        "keywords": [
