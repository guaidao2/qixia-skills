  "commands": [
    {
      "name": "status",
      "argv": "python3 qixia.py status",
      "purpose": "列出三层文件清单与计数",
      "json": true
    },
    {
      "name": "where",
      "argv": "python3 qixia.py where",
      "purpose": "打印包根目录绝对路径（供 agent 解析相对路径）",
      "json": true
    },
    {
      "name": "ask",
      "argv": "python3 qixia.py ask \"<情境>\"",
      "purpose": "情境 → 模式(P) + 模型(G) 联合路由 + 下一步命令",
      "json": true
    },
    {
      "name": "route",
      "argv": "python3 qixia.py route \"<情境>\" --json",
      "purpose": "ask 的机器可读形态（推荐 agent 使用）",
      "json": true
    },
    {
      "name": "pattern_eight",
      "argv": "python3 qixia.py pattern eight",
      "purpose": "谋略八问：未知环境的第一步",
      "json": true
    },
    {
      "name": "pattern_match",
      "argv": "python3 qixia.py pattern match \"<情境>\"",
      "purpose": "只做模式匹配",
      "json": true
    },
    {
      "name": "pattern_show",
      "argv": "python3 qixia.py pattern show P4",
      "purpose": "读某模式全貌（触发/步骤/失败/反制/checklist）",
      "json": true
    },
    {
      "name": "pattern_premortem",
      "argv": "python3 qixia.py pattern premortem P3",
      "purpose": "事前验尸：先排失败条件",
      "json": true
    },
    {
      "name": "pattern_check",
      "argv": "python3 qixia.py pattern check P1",
      "purpose": "打印执行清单",
      "json": true
    },
    {
      "name": "gt_models",
      "argv": "python3 qixia.py run models",
      "purpose": "模型索引（以引擎内置输出为准，避免文档漂移）",
      "json": false
    },
    {
      "name": "gt_flow",
      "argv": "python3 qixia.py run flow",
      "purpose": "S0–S6 总决策流水线",
      "json": false
    },
    {
      "name": "gt_audit",
      "argv": "python3 qixia.py run audit --file <situation.json> [--json] [--out x.md]",
      "purpose": "局面全审计：自动识别模型 + 跑求解器 + 汇总 gaps",
      "json": true
    },
    {
      "name": "gt_solver",
      "argv": "python3 qixia.py run <solver> --file <case.json> [--json] [--out x.md]",
      "purpose": "单模型求解（solver 名见 run models）",
      "json": true
    },
    {
      "name": "gt_checklist",
      "argv": "python3 qixia.py run checklist --model G4 --format json",
      "purpose": "导出 checklist（可做 agent 的硬门禁输入）",
      "json": true
    },
    {
      "name": "gt_selftest",
      "argv": "python3 qixia.py run selftest",
      "purpose": "引擎自检",
      "json": false
    },
    {
      "name": "doctor",
      "argv": "python3 qixia.py doctor",
      "purpose": "全包体检：文件齐备 + 双引擎自检 + 文档命令冒烟",
      "json": true
    },
    {
      "name": "pack",
      "argv": "python3 qixia.py pack",
