      "id": "L1",
      "name": "方法论层（P1–P5）",
      "role": "用什么招：触发条件、执行步骤、失败条件、反制手段",
      "read_order": 2,
      "paths": [
        "methodology/00-methodology-overview.md",
        "methodology/01-rule-recon.md",
        "methodology/02-rule-deception.md",
        "methodology/03-nested-plans.md",
