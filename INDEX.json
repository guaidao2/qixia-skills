    },
    {
      "name": "package_check",
      "argv": "python3 scripts/check_package.py",
      "purpose": "交付层全包自洽验收（结构/索引/交叉链接/计数/可复现）",
      "json": true
    },
    {
      "name": "package_build",
      "argv": "sh build_package.sh",
      "purpose": "确定性打包（tar.gz+zip+sha256+解包自检）",
      "json": false
    }
  ],
  "prompt_templates": [
    {
      "id": "T0",
      "file": "prompts/00-system-agent.md",
      "when": "把 skill 挂进 agent 的 system prompt / 技能目录时",
      "variables": []
    },
    {
      "id": "T1",
      "file": "prompts/01-rule-audit.md",
      "when": "拿到一套新规则、想找隐藏规则与漏洞",
      "variables": [
        "规则原文",
        "裁判/主办方",
        "赌注"
      ]
    },
    {
      "id": "T2",
      "file": "prompts/02-full-audit.md",
      "when": "局面复杂、需要一次跑通 P+G 全链条",
      "variables": [
        "局面描述",
        "已知/未知",
        "时间压力"
      ]
    },
    {
      "id": "T3",
      "file": "prompts/03-nested-plan.md",
      "when": "正面打不过，需要布局/连环计",
      "variables": [
        "我方劣势",
        "对手痛点",
        "可用筹码"
      ]
    },
    {
      "id": "T4",
      "file": "prompts/04-negotiation-bet.md",
      "when": "谈判/结盟/对赌/承诺设计",
      "variables": [
        "标的",
        "对手",
        "判定函数",
        "筹码",
        "时限"
      ]
    },
    {
      "id": "T5",
      "file": "prompts/05-debrief.md",
      "when": "一局结束后的复盘与参数更新",
      "variables": [
        "实际过程",
        "原计划",
        "结果"
      ]
    },
    {
      "id": "T6",
      "file": "prompts/06-quick-oneshot.md",
      "when": "只想要一句话结论（最省 token 的调用）",
      "variables": [
        "问题"
      ]
    }
  ],
  "workflows": [
    {
      "id": "W0",
      "name": "冷启动（进入未知场景）",
      "steps": [
        "python3 qixia.py pattern eight",
        "python3 qixia.py ask \"<场景一句话>\"",
        "python3 qixia.py pattern show <P?>",
        "python3 qixia.py pattern premortem <P?>"
      ]
    },
    {
      "id": "W1",
      "name": "规则审计（只判断规则，不下注）",
      "steps": [
        "按 SCHEMAS.md 写 situation.json（只填 g4 段也能跑）",
        "python3 qixia.py run audit --file <situation.json> --json",
        "读 gaps[]：规则未定义 / 激励不相容 / 参数缺失",
        "python3 qixia.py pattern check P1 逐项打勾"
      ]
    },
    {
      "id": "W2",
      "name": "定量决策（要数字）",
      "steps": [
        "python3 qixia.py run <solver> --file <case.json> --json",
